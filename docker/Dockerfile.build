# OpenFOAM Linux build environment (isolated from stock ubuntu / runtime images).

ARG UBUNTU_VERSION=24.04
ARG TARGETARCH

FROM ubuntu:${UBUNTU_VERSION}

ARG APT_MIRROR=
ARG TARGETARCH

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    DEBIAN_FRONTEND=noninteractive

COPY docker/apt_setup.sh /tmp/apt_setup.sh
COPY scripts/linux_build_packages.txt /tmp/linux_build_packages.txt

# --break-system-packages exists from pip 23; jammy ships pip 22.
RUN chmod +x /tmp/apt_setup.sh \
  && APT_MIRROR=${APT_MIRROR} /tmp/apt_setup.sh \
  && apt-get install -y --no-install-recommends \
       $(grep -v '^#' /tmp/linux_build_packages.txt | grep -v '^[[:space:]]*$') \
       jq docker.io docker-buildx \
  && python3 -m pip install --upgrade pip \
  && pip_extra="$(python3 -m pip install --help 2>/dev/null | grep -q -- --break-system-packages && echo --break-system-packages || true)" \
  && python3 -m pip install ${pip_extra} setuptools wheel mpi4py \
  && rm -rf /var/lib/apt/lists/* /tmp/apt_setup.sh /tmp/linux_build_packages.txt
